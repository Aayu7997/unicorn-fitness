# =============================================================================
# Unicorn Fitness Club - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# --- Database (Neon PostgreSQL) ---
# Direct connection (used for migrations)
DIRECT_URL="postgresql://user:password@ep-young-bar-ap0hyqsg.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Pooled connection (used for application runtime)
DATABASE_URL="postgresql://user:password@ep-young-bar-ap0hyqsg-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (NextAuth / JWT) ---
NEXTAUTH_URL="http://localhost:3333"
NEXTAUTH_SECRET="replace-with-a-secure-32-byte-hex-string"
JWT_SECRET="replace-with-a-secure-32-byte-hex-string"

# --- Cloudinary (Image & Video Uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# --- AI Engine (Groq / Google GenAI) ---
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# --- Resend (Email Notifications & Verification) ---
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Unicorn Fitness <noreply@yourdomain.com>"
CONTACT_EMAIL="contact@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"

# --- Site URL & Metadata ---
NEXT_PUBLIC_SITE_URL="http://localhost:3333"
NEXT_PUBLIC_SITE_NAME="Unicorn Fitness Club"
NODE_ENV="development"

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. NEON DATABASE:
#    a. Go to https://neon.tech and sign up
#    b. Create a project and copy the connection string into DATABASE_URL
#    c. Run: npm run db:generate
#    d. Run: npm run db:migrate
#    e. Run: npm run db:seed
#
# 2. CLOUDINARY:
#    a. Go to https://cloudinary.com
#    b. Copy Cloud name, API Key, API Secret from dashboard
#    c. Create an upload preset named "unicorn_fitness"
#
# 3. RESEND:
#    a. Go to https://resend.com -> API Keys
#    b. Create a key and paste into RESEND_API_KEY
